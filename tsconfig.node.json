{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vitest.config.*",
    "eslint.config.*",
    "scripts/**/*",
    "packages/*/scripts/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "bun"
    ]
  }
}
